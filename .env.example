# TypeSafe Jev
TYPESAFE_API_KEY=

# Cognigy — the API host, the region-matched OData host, and a key for both
COGNIGY_API_BASE=https://api-trial-us.cognigy.ai
COGNIGY_ODATA_BASE=https://odata-trial-us.cognigy.ai/v2.4
COGNIGY_API_KEY=
COGNIGY_PROJECT_ID=

# Optional. The Cognigy Flow editor host, used to link briefing excerpts to the
# node that produced them. Derived from COGNIGY_API_BASE by dropping a leading
# `api-` prefix, so it is only needed where that rule does not hold.
# COGNIGY_APP_BASE=https://your-cognigy.example.com

# Agent Watch. The public address Cognigy posts logged LLM calls to — a
# Cloudflare tunnel in front of this machine. Without it, logging can be read
# but not switched on. Example: https://agentwatch.example.com
# AGENT_WATCH_PUBLIC_URL=
